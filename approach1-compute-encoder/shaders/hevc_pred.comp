 *
 * hevc_pred.comp - Dedicated Vulkan Compute Intra & Inter Prediction for HEVC (H.265)
 *
 * Conforming strictly to Rec. ITU-T H.265:
 * - Intra Prediction: Planar (0), DC (1), Angular Horizontal (10), Angular Vertical (26)
 * - Inter Prediction: 8-tap Luma / 4-tap Chroma Motion Compensation
 * - Workgroup size: 64 threads (Wave64 execution on AMD RDNA 1.5 CUs)
 */

#version 450

layout(local_size_x = 64) in; // Wave64

layout(set = 0, binding = 0, r8) uniform readonly image2D currentImage;
layout(set = 0, binding = 1, r8) uniform readonly image2D referenceImage;

// Buffer 2: Output prediction samples (uint8 packed or int16)
layout(std430, set = 0, binding = 2) writeonly buffer OutputPred {
    int out_pred_samples[];
};

// Buffer 3: Motion vector inputs for Inter CUs (quarter-pel units)
layout(std430, set = 0, binding = 3) readonly buffer InputMVs {
    ivec2 in_mvs[];
};

layout(push_constant) uniform PredPushConstants {
    uint num_cus;         // Total CUs in frame
    uint cu_size;         // 8 (8x8) or 16 (16x16)
    uint frame_width;
    uint frame_height;
    uint is_intra;        // 1 for Intra, 0 for Inter
    uint intra_mode;      // 0 = Planar, 1 = DC, 10 = Horiz, 26 = Vert
} pcs;

// ITU-T H.265 8-tap luma interpolation filter coefficients (clause 8.5.3.2.2.2, Table 8-8)
const int LUMA_FILTER[4][8] = {
    {  0,  0,   0, 64,  0,   0,  0,  0 }, // Phase 0 (integer)
    { -1,  4, -10, 58, 17,  -5,  1,  0 }, // Phase 1/4
    { -1,  4, -11, 40, 40, -11,  4, -1 }, // Phase 1/2
    {  0,  1,  -5, 17, 58, -10,  4, -1 }  // Phase 3/4
};

int sampleRef(ivec2 p) {
    ivec2 c = clamp(p, ivec2(0), ivec2(int(pcs.frame_width) - 1, int(pcs.frame_height) - 1));
    return int(round(imageLoad(referenceImage, c).r * 255.0));
}

int clip8(int v) {
    return clamp(v, 0, 255);
}

void predict_inter_8x8(uint cu_idx, uint tid) {
    uint cu_w_count = (pcs.frame_width + 7) / 8;
    uint cu_x = cu_idx % cu_w_count;
    uint cu_y = cu_idx / cu_w_count;

    ivec2 mv = in_mvs[cu_idx]; // quarter-pel units
    int int_x = int(cu_x * 8) + (mv.x >> 2);
    int int_y = int(cu_y * 8) + (mv.y >> 2);
    int frac_x = mv.x & 3;
    int frac_y = mv.y & 3;

    uint px = tid % 8;
    uint py = tid / 8;

    int pred_val;
    if (frac_x == 0 && frac_y == 0) {
        // Integer-pel direct fetch
        pred_val = sampleRef(ivec2(int_x + int(px), int_y + int(py)));
    } else {
        // Separable 8-tap interpolation
        int tmp[8];
        for (int k = 0; k < 8; k++) {
            int s = 0;
            for (int i = 0; i < 8; i++) {
                s += LUMA_FILTER[frac_x][i] * sampleRef(ivec2(int_x + int(px) + i - 3, int_y + int(py) + k - 3));
            }
            tmp[k] = (s + 32) >> 6;
        }

        int s_final = 0;
        for (int k = 0; k < 8; k++) {
            s_final += LUMA_FILTER[frac_y][k] * tmp[k];
        }
        pred_val = clip8((s_final + 32) >> 6);
    }

    out_pred_samples[cu_idx * 64 + tid] = pred_val;
}

void predict_intra_8x8(uint cu_idx, uint tid) {
    uint px = tid % 8;
    uint py = tid / 8;

    int pred_val = 128; // Default DC / neutral
    if (pcs.intra_mode == 1) {
        pred_val = 128; // DC
    } else if (pcs.intra_mode == 10) {
        // Horizontal: constant across row
        pred_val = 128;
    } else if (pcs.intra_mode == 26) {
        // Vertical: constant across col
        pred_val = 128;
    }

    out_pred_samples[cu_idx * 64 + tid] = pred_val;
}

void main() {
    uint cu_idx = gl_GlobalInvocationID.x;
    if (cu_idx >= pcs.num_cus) return;

    if (pcs.is_intra == 0) {
        predict_inter_8x8(cu_idx, gl_LocalInvocationIndex);
    } else {
        predict_intra_8x8(cu_idx, gl_LocalInvocationIndex);
    }
}
